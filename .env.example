# Copy this to .env.local (or .env) and fill in real values.
# In production these are set in the Vercel project's Environment Variables.

# Postgres connection string. Provisioned automatically when you add a
# Postgres database from the Vercel project's Storage tab, or `vercel env pull`
# after linking the project.
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Signs session cookies. Generate a fresh one per environment with:
#   openssl rand -base64 32
# Never reuse the same secret between local dev and production.
SESSION_SECRET=""

# Vercel Blob (resume storage) auth. `@vercel/blob` authenticates automatically
# using BLOB_STORE_ID + VERCEL_OIDC_TOKEN when both are present (the modern,
# short-lived-token approach) -- both are set for you by `vercel env pull` once
# a Blob store is connected to the project, no manual token needed. Falls back
# to a static BLOB_READ_WRITE_TOKEN only if you're not using OIDC.
BLOB_STORE_ID=""
